---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const entries = [
  {
    company: 'Conversia — Signo',
    role: 'Senior Backend Developer',
    period: t('exp.1.period'),
    stack: ['C#', '.NET 8', 'Azure Service Bus', 'CQRS', 'Microservices'],
    desc: t('exp.1.desc'),
  },
  {
    company: 'UST — Viajes El Corte Inglés',
    role: 'Senior Backend Developer',
    period: t('exp.2.period'),
    stack: ['C#', '.NET 8', 'MongoDB', 'Hangfire', 'Clean Architecture', 'Microservices'],
    desc: t('exp.2.desc'),
  },
  {
    company: 'Grupo Solutio — OTT (LaLigaTech / Sportian)',
    role: 'Backend Developer',
    period: t('exp.3.period'),
    stack: ['C#', '.NET 6→8', 'SQL Server', 'Cosmos DB', 'Redis', 'Azure Service Bus', 'CQRS'],
    desc: t('exp.3.desc'),
  },
  {
    company: 'Deloitte — Trade Promotion Optimization',
    role: 'Backend Developer',
    period: t('exp.4.period'),
    stack: ['C#', '.NET', 'Azure Functions', 'ML integration (Python)'],
    desc: t('exp.4.desc'),
  },
  {
    company: 'Everis — IDB / BID',
    role: 'Backend Developer',
    period: t('exp.5.period'),
    stack: ['C#', '.NET Core 3.1', 'SQL Server', 'Razor', 'JavaScript', 'TDD / DDD'],
    desc: t('exp.5.desc'),
  },
  {
    company: 'Everis — CHAFEA (European Commission)',
    role: 'Backend Developer',
    period: t('exp.6.period'),
    stack: ['C#', '.NET', 'AWS Lambda', 'DynamoDB'],
    desc: t('exp.6.desc'),
  },
];
---

<section id="experience" class="section fade-in">
  <div class="container">
    <h2 class="section-title">{t('placeholder.experience.heading')}</h2>
    <div class="timeline">
      {entries.map((entry) => (
        <div class="timeline-item">
          <div class="timeline-marker" aria-hidden="true"></div>
          <div class="timeline-card">
            <div class="timeline-header">
              <span class="timeline-company">{entry.company}</span>
              <span class="timeline-period">{entry.period}</span>
            </div>
            <h3 class="timeline-role">{entry.role}</h3>
            <p class="timeline-desc">{entry.desc}</p>
            <ul class="chip-list" role="list">
              {entry.stack.map((tech) => (
                <li class="chip">{tech}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline-item {
    position: relative;
    padding-left: 30px;
    padding-bottom: var(--space-xl);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  /* Line segment from current marker center to next marker center */
  .timeline-item:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 12px;
    height: 100%;
    width: 2px;
    background: var(--color-border);
  }

  .timeline-marker {
    position: absolute;
    left: 0;
    top: 5px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
  }

  .timeline-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .timeline-company {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }

  .timeline-period {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  .timeline-role {
    font-size: var(--text-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    margin: 0;
  }

  .timeline-desc {
    font-size: var(--text-base);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }
</style>
