---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Deterministic node layout — LCG seed 42, runs at build time, zero browser JS
function lcgRand(seed: number): () => number {
  let s = seed;
  return (): number => {
    s = (1664525 * s + 1013904223) % 4294967296;
    return s / 4294967296;
  };
}

const W = 1200;
const H = 600;
const N = 45;
const rand = lcgRand(42);

interface NodePos { x: number; y: number }
const nodes: NodePos[] = Array.from({ length: N }, () => ({
  x: Math.round(rand() * W),
  y: Math.round(rand() * H),
}));

interface Edge { a: number; b: number }
const edges: Edge[] = [];
const degree = new Array<number>(N).fill(0);
const DIST = 220;
const MAX_DEG = 3;

for (let i = 0; i < N; i++) {
  const near: { j: number; d: number }[] = [];
  for (let j = i + 1; j < N; j++) {
    const dx = nodes[i].x - nodes[j].x;
    const dy = nodes[i].y - nodes[j].y;
    const d = Math.sqrt(dx * dx + dy * dy);
    if (d < DIST) near.push({ j, d });
  }
  near.sort((a, b) => a.d - b.d);
  for (const { j } of near) {
    if (degree[i] >= MAX_DEG || degree[j] >= MAX_DEG) continue;
    edges.push({ a: i, b: j });
    degree[i]++;
    degree[j]++;
  }
}
---

<section class="hero">
  <svg
    class="hero-bg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    {edges.map(({ a, b }) => (
      <line
        x1={nodes[a].x}
        y1={nodes[a].y}
        x2={nodes[b].x}
        y2={nodes[b].y}
      />
    ))}
    {nodes.map(({ x, y }) => (
      <circle cx={x} cy={y} r="3" />
    ))}
  </svg>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container">
    <span class="hero-label">{t('hero.label')}</span>
    <h1 class="hero-name">{t('hero.name')}</h1>
    <p class="hero-role">{t('hero.role')}</p>
    <p class="hero-spec">{t('hero.spec')}</p>
    <div class="hero-divider" aria-hidden="true"></div>
    <p class="hero-tagline">{t('hero.tagline')}</p>
    <a href="#contact" class="hero-cta">{t('hero.cta')}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl);
  }

  /* SVG fills the hero behind everything */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero-bg line {
    stroke: var(--color-accent-dim);
    stroke-width: 1;
    fill: none;
    opacity: 0.4;
  }

  .hero-bg circle {
    fill: var(--color-accent);
    opacity: 0.5;
  }

  /* Entry animation — opacity only (compositor, no layout) */
  .hero-bg {
    animation: hero-bg-in 1.2s ease-out 0.1s both;
  }

  @keyframes hero-bg-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg { animation: none; }
  }

  /* Scrim: solid bg on text side, fades toward node side */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--color-bg) 0%, transparent 55%);
    pointer-events: none;
    z-index: 1;
  }

  /* Text floats above SVG and scrim */
  .hero .container {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
  }

  .hero-label {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }

  .hero-name {
    font-size: clamp(2.25rem, 7vw, 3.5rem);
    font-weight: var(--font-weight-bold);
    line-height: var(--lh-tight);
    color: var(--color-text);
    margin: 0 0 8px;
  }

  .hero-role {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-normal);
    line-height: var(--lh-snug);
    color: var(--color-text-muted);
    margin: 0 0 4px;
  }

  .hero-spec {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero-divider {
    height: 2px;
    width: 40px;
    background: var(--color-accent);
    margin: 28px 0 24px;
  }

  .hero-tagline {
    font-size: var(--text-base);
    font-weight: var(--font-weight-normal);
    line-height: 1.7;
    max-width: 480px;
    margin: 0 0 24px;
    color: var(--color-text);
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    padding: 12px 28px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: opacity 150ms ease;
  }

  .hero-cta:hover {
    opacity: 0.88;
    text-decoration: none;
  }
</style>
